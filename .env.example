# Amora API configuration. Validated at boot by src/common/config/config.ts; production refuses to start with dev
# adapters, insecure admin cookies, MFA or rate limiting off, or without S3.
# Generate secrets with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"

# ---- Core
NODE_ENV=development
PORT=3000
DATABASE_URL=postgres://amora:amora@localhost:5433/amora
DATABASE_POOL_MAX=20
TRUST_PROXY=false
CORS_ORIGINS=http://localhost:3001
# Background workers (outbox, jobs). Set false on web-only replicas if you run a dedicated worker deployment.
WORKERS_ENABLED=true
OUTBOX_POLL_MS=1000
RATE_LIMIT_ENABLED=true
# Redis: realtime fan-out, presence and shared rate-limit counters. Optional on a single instance; required to run 2+.
# REDIS_URL=redis://localhost:6379

# ---- Secrets (each ≥ 32 chars; FIELD_ENCRYPTION_KEY = base64 of 32 random bytes)
JWT_ACCESS_SECRET=change-me-to-a-random-32-byte-secret-value
OTP_PEPPER=change-me-to-another-random-32-byte-secret
SIGNING_SECRET=change-me-to-a-third-random-32-byte-secret
FIELD_ENCRYPTION_KEY=
# Rotation: new key + bumped version; old keys as "<version>:<base64>" until `npm run db:rotate-encryption` reports 0.
FIELD_ENCRYPTION_KEY_VERSION=1
# FIELD_ENCRYPTION_RETIRED_KEYS=

# ---- Sessions & login protection
JWT_ISSUER=amora-api
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=30
SESSION_MAX_AGE_DAYS=180
OTP_TTL_SECONDS=600
OTP_MAX_PER_HOUR=5
OTP_RESEND_COOLDOWN_SECONDS=60
# Development only: every OTP (sign-up, login, verification) is this fixed code. Refused in production.
# OTP_DEV_STATIC_CODE=123456
LOGIN_MAX_FAILURES=5
LOGIN_LOCKOUT_BASE_SECONDS=900

# ---- Admin console
ADMIN_CONSOLE_URL=http://localhost:3001
ADMIN_SESSION_TTL_HOURS=8
ADMIN_COOKIE_SECURE=false
ADMIN_REQUIRE_MFA=false
# Seed: bootstrap Super Admin
ADMIN_BOOTSTRAP_EMAIL=admin@amora.local
ADMIN_BOOTSTRAP_PASSWORD=

# ---- Links
PUBLIC_WEB_URL=http://localhost:3002
APP_DEEP_LINK_SCHEME=amora

# ---- Email / SMS ('dev' adapters are not allowed in production)
EMAIL_PROVIDER=dev
EMAIL_FROM=LOL <no-reply@amora.local>
# EMAIL_PROVIDER=smtp
# SMTP_URL=smtp://localhost:1025
SMS_PROVIDER=dev
# SMS_PROVIDER=twilio
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_FROM=

# ---- Social sign-in (empty = provider disabled)
GOOGLE_CLIENT_IDS=
APPLE_CLIENT_IDS=
# FACEBOOK_APP_ID=
# FACEBOOK_APP_SECRET=
# FACEBOOK_GRAPH_BASE=https://graph.facebook.com/v21.0

# ---- Push notifications (missing provider = channel skipped and recorded as suppressed)
# FCM_SERVICE_ACCOUNT_JSON_B64=
# APNS_KEY_P8_B64=
# APNS_KEY_ID=
# APNS_TEAM_ID=
# APNS_BUNDLE_ID=
APNS_PRODUCTION=false

# ---- Object storage (S3-compatible; MinIO locally via docker-compose). Required in production.
# S3_BUCKET=amora-dev
S3_REGION=us-east-1
# S3_ENDPOINT=http://localhost:9000
S3_FORCE_PATH_STYLE=false
# S3_ACCESS_KEY_ID=amora
# S3_SECRET_ACCESS_KEY=amora-dev-secret
MEDIA_UPLOAD_URL_TTL_SECONDS=600
MEDIA_DOWNLOAD_URL_TTL_SECONDS=3600

# ---- Payments (each optional; unconfigured = PAYMENT_PROVIDER_NOT_CONFIGURED)
# STRIPE_SECRET_KEY=
# STRIPE_WEBHOOK_SECRET=
STRIPE_API_BASE=https://api.stripe.com
CHECKOUT_RETURN_ORIGINS=http://localhost:3002,amora://
# APPLE_BUNDLE_ID=
APPLE_ENVIRONMENT=Sandbox
# Apple Root CA - G3 SHA-256 fingerprint(s), comma-separated
# APPLE_ROOT_FINGERPRINTS=
# GOOGLE_PLAY_PACKAGE=
# GOOGLE_PLAY_SA_JSON_B64=
# GOOGLE_RTDN_AUDIENCE=
# GOOGLE_RTDN_SA_EMAIL=

# ---- Calls (LiveKit-compatible SFU; empty = calls unavailable)
# LIVEKIT_URL=
# LIVEKIT_API_KEY=
# LIVEKIT_API_SECRET=

# ---- Safety
# none = human review queue (or auto-approve per admin setting); rekognition uses the standard AWS credential chain
IMAGE_MODERATION_PROVIDER=none

# ---- Search (empty = Postgres adapter)
# OPENSEARCH_URL=http://localhost:9200
OPENSEARCH_INDEX=profiles
# OPENSEARCH_AUTH=

# ---- AI providers: keys are read from the env var named in Admin → AI → Providers (secret_ref), e.g.
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=

# ---- Observability
# json = one structured access-log line per request (use in production)
LOG_FORMAT=text
# Bearer token required by GET /metrics (≥ 16 chars). Without it /metrics is disabled in production.
# METRICS_TOKEN=
