{
  "name": "@amora/api",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "dev": "node --watch -r @swc-node/register src/main.ts",
    "start": "node dist/main.js",
    "test": "jest --runInBand --no-watchman",
    "test:unit": "jest --selectProjects unit",
    "test:e2e": "jest --runInBand --selectProjects e2e",
    "db:migrate": "node -r @swc-node/register scripts/migrate.ts",
    "db:seed": "node -r @swc-node/register scripts/seed.ts",
    "db:rotate-encryption": "node -r @swc-node/register scripts/rotate-field-encryption.ts",
    "db:codegen": "kysely-codegen --dialect postgres --date-parser string --out-file src/common/db/schema.ts",
    "db:seed-demo": "node -r @swc-node/register scripts/seed-demo.ts"
  },
  "dependencies": {
    "@amora/shared": "*",
    "@aws-sdk/client-rekognition": "^3.1147.0",
    "@aws-sdk/client-s3": "^3.1147.0",
    "@aws-sdk/s3-request-presigner": "^3.1147.0",
    "@nestjs/common": "^12.0.0",
    "@nestjs/core": "^12.0.0",
    "@nestjs/platform-express": "^12.0.0",
    "@nestjs/platform-ws": "^12.1.2",
    "@nestjs/swagger": "^12.0.0",
    "@nestjs/throttler": "^6.7.1",
    "@nestjs/websockets": "^12.1.2",
    "@node-rs/argon2": "^2.0.2",
    "ajv": "^8.20.0",
    "cookie-parser": "^1.4.7",
    "helmet": "^8.3.0",
    "ioredis": "^6.0.0",
    "jose": "^6.0.0",
    "kysely": "^0.29.6",
    "nodemailer": "^10.0.16",
    "pg": "^8.23.1",
    "prom-client": "^15.1.3",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "sharp": "^0.35.5",
    "ws": "^8.22.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@nestjs/testing": "^12.0.0",
    "@swc-node/register": "^1.10.0",
    "@swc/core": "^1.13.0",
    "@swc/jest": "^0.2.39",
    "@types/cookie-parser": "^1.4.8",
    "@types/express": "^5.0.0",
    "@types/jest": "^30.0.0",
    "@types/node": "^22.0.0",
    "@types/nodemailer": "^6.4.17",
    "@types/pg": "^8.11.0",
    "@types/supertest": "^6.0.0",
    "@types/ws": "^8.18.2",
    "jest": "^30.5.2",
    "kysely-codegen": "^0.20.0",
    "supertest": "^7.1.0",
    "typescript": "~6.0.3"
  }
}
